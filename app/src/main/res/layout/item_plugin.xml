<?xml version="1.0" encoding="utf-8"?>
<!-- item_plugin.xml - Plugin list item layout -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="?attr/selectableItemBackground"
    android:minHeight="80dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Plugin icon -->
        <ImageView
            android:id="@+id/plugin_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_launcher_foreground"
            android:tint="@color/primary"
            tools:ignore="ContentDescription" />

        <!-- Plugin info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Plugin name -->
            <TextView
                android:id="@+id/plugin_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Plugin Name"
                android:textColor="@color/on_surface"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Cline Agent" />

            <!-- Plugin version -->
            <TextView
                android:id="@+id/plugin_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="v1.0.0"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp"
                tools:text="v0.1.0" />

        </LinearLayout>

        <!-- Plugin state -->
        <TextView
            android:id="@+id/plugin_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enabled"
            android:textColor="@color/status_success"
            android:textSize="12sp"
            android:background="@drawable/shape_rounded_corner_small"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            tools:text="Enabled" />

    </LinearLayout>

    <!-- Plugin description -->
    <TextView
        android:id="@+id/plugin_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Plugin description goes here"
        android:textColor="@color/on_surface_variant"
        android:textSize="14sp"
        android:maxLines="2"
        android:ellipsize="end"
        tools:text="A powerful AI coding agent plugin" />

    <!-- Plugin author -->
    <TextView
        android:id="@+id/plugin_author"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Author: Unknown"
        android:textColor="@color/on_surface_variant"
        android:textSize="12sp"
        tools:text="By Cline Team" />

</LinearLayout>
