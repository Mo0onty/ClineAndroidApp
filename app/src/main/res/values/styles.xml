<?xml version="1.0" encoding="utf-8"?>
<!-- styles.xml - Material Design 3 Expressive Styles -->
<resources>
    <!-- ==================================================================== -->
    <!-- Base Styles -->
    <!-- ==================================================================== -->
    
    <!-- Text Appearances -->
    <style name="TextAppearance.Cline" parent="TextAppearance.Material3">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    
    <!-- Display Styles -->
    <style name="TextAppearance.Cline.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    
    <style name="TextAppearance.Cline.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    
    <style name="TextAppearance.Cline.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    
    <!-- Headline Styles -->
    <style name="TextAppearance.Cline.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    
    <style name="TextAppearance.Cline.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    
    <style name="TextAppearance.Cline.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    
    <!-- Title Styles -->
    <style name="TextAppearance.Cline.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontWeight">bold</item>
    </style>
    
    <style name="TextAppearance.Cline.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontWeight">bold</item>
    </style>
    
    <style name="TextAppearance.Cline.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontWeight">bold</item>
    </style>
    
    <!-- Body Styles -->
    <style name="TextAppearance.Cline.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    
    <style name="TextAppearance.Cline.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    
    <style name="TextAppearance.Cline.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    
    <!-- Label Styles -->
    <style name="TextAppearance.Cline.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    
    <style name="TextAppearance.Cline.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    
    <style name="TextAppearance.Cline.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    
    <!-- ==================================================================== -->
    <!-- Widget Styles -->
    <!-- ==================================================================== -->
    
    <!-- Button Styles -->
    <style name="Widget.Cline.Button" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">8dp</item>
    </style>
    
    <style name="Widget.Cline.Button.Outlined" parent="Widget.Material3.OutlinedButton">
        <item name="android:strokeColor">?attr/colorOutline</item>
        <item name="android:strokeWidth">1dp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">8dp</item>
    </style>
    
    <style name="Widget.Cline.Button.Text" parent="Widget.Material3.TextButton">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textAllCaps">false</item>
    </style>
    
    <style name="Widget.Cline.Button.Icon" parent="Widget.Material3.IconButton">
        <item name="android:tint">?attr/colorOnSurfaceVariant</item>
        <item name="app:tint">?attr/colorOnSurfaceVariant</item>
    </style>
    
    <!-- Text View Styles -->
    <style name="Widget.Cline.TextView" parent="Widget.Material3.TextView">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    
    <style name="Widget.Cline.TextView.Title" parent="Widget.Cline.TextView">
        <item name="android:textAppearance">@style/TextAppearance.Cline.TitleLarge</item>
    </style>
    
    <style name="Widget.Cline.TextView.Body" parent="Widget.Cline.TextView">
        <item name="android:textAppearance">@style/TextAppearance.Cline.BodyLarge</item>
    </style>
    
    <style name="Widget.Cline.TextView.Caption" parent="Widget.Cline.TextView">
        <item name="android:textAppearance">@style/TextAppearance.Cline.LabelSmall</item>
    </style>
    
    <!-- Edit Text Styles -->
    <style name="Widget.Cline.EditText" parent="Widget.Material3.TextInputEditText">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:hintTextColor">?attr/colorOnSurfaceVariant</item>
    </style>
    
    <style name="Widget.Cline.EditText.Outlined" parent="Widget.Material3.OutlinedTextInputLayout">
        <item name="boxStrokeColor">?attr/colorOutline</item>
        <item name="boxBackgroundColor">?attr/colorSurface</item>
        <item name="hintTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="counterTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="errorTextColor">?attr/colorError</item>
        <item name="helperTextTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="prefixTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="suffixTextColor">?attr/colorOnSurfaceVariant</item>
    </style>
    
    <!-- Card Styles -->
    <style name="Widget.Cline.Card" parent="Widget.Material3.CardView">
        <item name="android:backgroundTint">?attr/colorSurfaceContainer</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="cardElevation">2dp</item>
        <item name="cardCornerRadius">12dp</item>
    </style>
    
    <style name="Widget.Cline.Card.Elevated" parent="Widget.Material3.CardView">
        <item name="android:backgroundTint">?attr/colorSurfaceContainer</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="cardElevation">6dp</item>
        <item name="cardCornerRadius">12dp</item>
    </style>
    
    <!-- ==================================================================== -->
    <!-- App-Specific Styles -->
    <!-- ==================================================================== -->
    
    <!-- Chat Bubble Styles -->
    <style name="Widget.Cline.ChatBubble.User" parent="Widget.Material3.CardView">
        <item name="cardBackgroundColor">?attr/colorPrimaryContainer</item>
        <item name="cardElevation">1dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardCornerRadiusTopLeft">16dp</item>
        <item name="cardCornerRadiusTopRight">16dp</item>
        <item name="cardCornerRadiusBottomLeft">4dp</item>
        <item name="cardCornerRadiusBottomRight">16dp</item>
    </style>
    
    <style name="Widget.Cline.ChatBubble.Assistant" parent="Widget.Material3.CardView">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="cardElevation">1dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardCornerRadiusTopLeft">16dp</item>
        <item name="cardCornerRadiusTopRight">16dp</item>
        <item name="cardCornerRadiusBottomLeft">16dp</item>
        <item name="cardCornerRadiusBottomRight">4dp</item>
    </style>
    
    <!-- Terminal Styles -->
    <style name="Widget.Cline.Terminal" parent="Widget.Material3.TextView">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">2sp</item>
    </style>
    
    <!-- Input Styles -->
    <style name="Widget.Cline.Input" parent="Widget.Material3.TextInputLayout">
        <item name="boxBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="boxStrokeColor">?attr/colorOutlineVariant</item>
        <item name="hintTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="counterTextColor">?attr/colorOnSurfaceVariant</item>
    </style>
    
    <!-- ==================================================================== -->
    <!-- Dialog Styles -->
    <!-- ==================================================================== -->
    
    <style name="Widget.Cline.Dialog" parent="ThemeOverlay.Material3.Dialog">
        <item name="android:background">?attr/colorSurfaceContainer</item>
        <item name="colorSurface">?attr/colorSurfaceContainer</item>
        <item name="colorOnSurface">?attr/colorOnSurface</item>
        <item name="colorPrimary">?attr/colorPrimary</item>
        <item name="colorOnPrimary">?attr/colorOnPrimary</item>
    </style>
    
    <style name="Widget.Cline.Dialog.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    
    <style name="Widget.Cline.Dialog.Message" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    
    <!-- ==================================================================== -->
    <!-- Bottom Navigation Styles -->
    <!-- ==================================================================== -->
    
    <style name="Widget.Cline.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">?attr/colorSurfaceContainer</item>
        <item name="itemIconTint">?attr/colorOnSurfaceVariant</item>
        <item name="itemTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="itemSelectedIconTint">?attr/colorPrimary</item>
        <item name="itemSelectedTextColor">?attr/colorPrimary</item>
        <item name="itemRippleColor">?attr/colorPrimaryContainer</item>
    </style>
    
    <!-- ==================================================================== -->
    <!-- Floating Action Button Styles -->
    <!-- ==================================================================== -->
    
    <style name="Widget.Cline.FloatingActionButton" parent="Widget.Material3.FloatingActionButton">
        <item name="android:backgroundTint">?attr/colorPrimaryContainer</item>
        <item name="android:tint">?attr/colorOnPrimaryContainer</item>
        <item name="app:tint">?attr/colorOnPrimaryContainer</item>
        <item name="app:backgroundTint">?attr/colorPrimaryContainer</item>
        <item name="elevation">6dp</item>
    </style>
    
    <style name="Widget.Cline.FloatingActionButton.Extended" parent="Widget.Material3.ExtendedFloatingActionButton">
        <item name="android:backgroundTint">?attr/colorPrimaryContainer</item>
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
        <item name="app:backgroundTint">?attr/colorPrimaryContainer</item>
        <item name="app:iconTint">?attr/colorOnPrimaryContainer</item>
        <item name="elevation">6dp</item>
    </style>
    
    <!-- ==================================================================== -->
    <!-- Top App Bar Styles -->
    <!-- ==================================================================== -->
    
    <style name="Widget.Cline.TopAppBar" parent="Widget.Material3.TopAppBar">
        <item name="android:background">?attr/colorSurfaceContainer</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
        <item name="navigationIconTint">?attr/colorOnSurface</item>
        <item name="menuIconTint">?attr/colorOnSurfaceVariant</item>
        <item name="actionIconTint">?attr/colorOnSurfaceVariant</item>
    </style>
    
    <style name="Widget.Cline.TopAppBar.Large" parent="Widget.Material3.TopAppBar.Large">
        <item name="android:background">?attr/colorSurfaceContainer</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
        <item name="navigationIconTint">?attr/colorOnSurface</item>
        <item name="menuIconTint">?attr/colorOnSurfaceVariant</item>
        <item name="actionIconTint">?attr/colorOnSurfaceVariant</item>
    </style>
    
    <!-- ==================================================================== -->
    <!-- Snackbar Styles -->
    <!-- ==================================================================== -->
    
    <style name="Widget.Cline.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="android:background">?attr/colorSurfaceContainer</item>
        <item name="snackbarTextViewStyle">@style/Widget.Cline.Snackbar.Text</item>
        <item name="snackbarActionButtonStyle">@style/Widget.Cline.Snackbar.Action</item>
    </style>
    
    <style name="Widget.Cline.Snackbar.Text" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    
    <style name="Widget.Cline.Snackbar.Action" parent="Widget.Material3.Button.Text">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>
    
    <!-- ==================================================================== -->
    <!-- Chip Styles -->
    <!-- ==================================================================== -->
    
    <style name="Widget.Cline.Chip" parent="Widget.Material3.Chip">
        <item name="android:backgroundTint">?attr/colorSurfaceVariant</item>
        <item name="chipStrokeColor">?attr/colorOutline</item>
        <item name="chipIconTint">?attr/colorOnSurfaceVariant</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="chipCornerRadius">16dp</item>
    </style>
    
    <style name="Widget.Cline.Chip.Filter" parent="Widget.Material3.FilterChip">
        <item name="android:backgroundTint">?attr/colorSurfaceVariant</item>
        <item name="chipStrokeColor">?attr/colorOutline</item>
        <item name="chipIconTint">?attr/colorOnSurfaceVariant</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="chipSelectedBackgroundColor">?attr/colorPrimaryContainer</item>
        <item name="chipSelectedIconTint">?attr/colorOnPrimaryContainer</item>
        <item name="chipSelectedTextColor">?attr/colorOnPrimaryContainer</item>
        <item name="chipCornerRadius">16dp</item>
    </style>
    
    <!-- ==================================================================== -->
    <!-- Tab Styles -->
    <!-- ==================================================================== -->
    
    <style name="Widget.Cline.Tab" parent="Widget.Material3.TabLayout.Tab">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textColorSelected">?attr/colorPrimary</item>
        <item name="tabIndicatorColor">?attr/colorPrimary</item>
        <item name="tabIndicatorHeight">2dp</item>
        <item name="tabCornerRadius">8dp</item>
    </style>
    
    <!-- ==================================================================== -->
    <!-- Card View Styles -->
    <!-- ==================================================================== -->
    
    <style name="Widget.Cline.CardView" parent="Widget.CardView">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="cardElevation">2dp</item>
        <item name="cardCornerRadius">12dp</item>
    </style>
    
    <!-- ==================================================================== -->
    <!-- Progress Styles -->
    <!-- ==================================================================== -->
    
    <style name="Widget.Cline.ProgressBar" parent="Widget.Material3.ProgressBar">
        <item name="android:indeterminateTint">?attr/colorPrimary</item>
        <item name="android:progressTint">?attr/colorPrimary</item>
        <item name="android:trackTint">?attr/colorSurfaceVariant</item>
    </style>
    
    <style name="Widget.Cline.ProgressBar.Circular" parent="Widget.Material3.ProgressBar.Circular">
        <item name="android:indeterminateTint">?attr/colorPrimary</item>
        <item name="android:progressTint">?attr/colorPrimary</item>
        <item name="android:trackTint">?attr/colorSurfaceVariant</item>
    </style>
    
    <!-- ==================================================================== -->
    <!-- Switch Styles -->
    <!-- ==================================================================== -->
    
    <style name="Widget.Cline.Switch" parent="Widget.Material3.Switch">
        <item name="android:thumbTint">?attr/colorPrimary</item>
        <item name="android:trackTint">?attr/colorSurfaceVariant</item>
        <item name="android:trackTintActivated">?attr/colorPrimaryContainer</item>
    </style>
    
    <!-- ==================================================================== -->
    <!-- Radio Button Styles -->
    <!-- ==================================================================== -->
    
    <style name="Widget.Cline.RadioButton" parent="Widget.Material3.RadioButton">
        <item name="android:buttonTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    
    <!-- ==================================================================== -->
    <!-- Checkbox Styles -->
    <!-- ==================================================================== -->
    
    <style name="Widget.Cline.Checkbox" parent="Widget.Material3.Checkbox">
        <item name="android:buttonTint">?attr/colorPrimary</item>
    </style>
    
    <!-- ==================================================================== -->
    <!-- Text Input Layout Styles -->
    <!-- ==================================================================== -->
    
    <style name="Widget.Cline.TextInputLayout" parent="Widget.Material3.TextInputLayout">
        <item name="boxBackgroundColor">?attr/colorSurface</item>
        <item name="boxStrokeColor">?attr/colorOutline</item>
        <item name="boxStrokeColorActivated">?attr/colorPrimary</item>
        <item name="boxStrokeColorFocused">?attr/colorPrimary</item>
        <item name="hintTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="counterTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="errorTextColor">?attr/colorError</item>
        <item name="helperTextTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="prefixTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="suffixTextColor">?attr/colorOnSurfaceVariant</item>
    </style>
    
    <style name="Widget.Cline.TextInputLayout.Outlined" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">?attr/colorSurface</item>
        <item name="boxStrokeColor">?attr/colorOutline</item>
        <item name="boxStrokeColorActivated">?attr/colorPrimary</item>
        <item name="boxStrokeColorFocused">?attr/colorPrimary</item>
        <item name="hintTextColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
