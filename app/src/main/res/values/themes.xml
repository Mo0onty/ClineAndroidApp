<?xml version="1.0" encoding="utf-8"?>
<!-- themes.xml - Cline AI Official Green Theme Definitions -->
<resources>
    <!-- ==================================================================== -->
    <!-- Light Theme (Cline AI Green Palette) -->
    <!-- ==================================================================== -->
    
    <style name="Theme.Cline.Light" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        
        <!-- Secondary Colors -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>
        
        <!-- Tertiary Colors -->
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorTertiaryContainer">@color/tertiary_container</item>
        <item name="colorOnTertiary">@color/on_tertiary</item>
        <item name="colorOnTertiaryContainer">@color/on_tertiary_container</item>
        
        <!-- Surface Colors -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerLow">@color/surface_container_low</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_high</item>
        <item name="colorSurfaceDim">@color/surface_dim</item>
        <item name="colorSurfaceBright">@color/surface_bright</item>
        <item name="colorSurfaceTint">@color/surface_tint</item>
        
        <!-- On Surface Colors -->
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOnSurfaceInverse">@color/on_surface_inverse</item>
        
        <!-- Background Colors -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/on_background</item>
        
        <!-- Error Colors -->
        <item name="colorError">@color/error</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorOnErrorContainer">@color/on_error_container</item>
        
        <!-- Outline Colors -->
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>
        
        <!-- Scrim -->
        <item name="colorScrim">@color/scrim</item>
        
        <!-- Inverse Colors -->
        <item name="colorInversePrimary">@color/inverse_primary</item>
        <item name="colorInverseSurface">@color/inverse_surface</item>
        
        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Navigation Bar -->
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightNavigationBar">false</item>
        
        <!-- Window -->
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>
    
    <!-- ==================================================================== -->
    <!-- Dark Theme (Cline AI Green Palette) -->
    <!-- ==================================================================== -->
    
    <style name="Theme.Cline.Dark" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary Colors -->
        <item name="colorPrimary">@color/dark_primary</item>
        <item name="colorPrimaryContainer">@color/dark_primary_container</item>
        <item name="colorOnPrimary">@color/dark_on_primary</item>
        <item name="colorOnPrimaryContainer">@color/dark_on_primary_container</item>
        
        <!-- Secondary Colors -->
        <item name="colorSecondary">@color/dark_secondary</item>
        <item name="colorSecondaryContainer">@color/dark_secondary_container</item>
        <item name="colorOnSecondary">@color/dark_on_secondary</item>
        <item name="colorOnSecondaryContainer">@color/dark_on_secondary_container</item>
        
        <!-- Tertiary Colors -->
        <item name="colorTertiary">@color/dark_tertiary</item>
        <item name="colorTertiaryContainer">@color/dark_tertiary_container</item>
        <item name="colorOnTertiary">@color/dark_on_tertiary</item>
        <item name="colorOnTertiaryContainer">@color/dark_on_tertiary_container</item>
        
        <!-- Surface Colors -->
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorSurfaceVariant">@color/dark_surface_variant</item>
        <item name="colorSurfaceContainer">@color/dark_surface_container</item>
        <item name="colorSurfaceContainerLow">@color/dark_surface_container_low</item>
        <item name="colorSurfaceContainerHigh">@color/dark_surface_container_high</item>
        <item name="colorSurfaceDim">@color/dark_surface_dim</item>
        <item name="colorSurfaceBright">@color/dark_surface_bright</item>
        <item name="colorSurfaceTint">@color/dark_surface_tint</item>
        
        <!-- On Surface Colors -->
        <item name="colorOnSurface">@color/dark_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/dark_on_surface_variant</item>
        <item name="colorOnSurfaceInverse">@color/dark_on_surface_inverse</item>
        
        <!-- Background Colors -->
        <item name="android:colorBackground">@color/dark_background</item>
        <item name="colorOnBackground">@color/dark_on_background</item>
        
        <!-- Error Colors -->
        <item name="colorError">@color/dark_error</item>
        <item name="colorErrorContainer">@color/dark_error_container</item>
        <item name="colorOnError">@color/dark_on_error</item>
        <item name="colorOnErrorContainer">@color/dark_on_error_container</item>
        
        <!-- Outline Colors -->
        <item name="colorOutline">@color/dark_outline</item>
        <item name="colorOutlineVariant">@color/dark_outline_variant</item>
        
        <!-- Scrim -->
        <item name="colorScrim">@color/dark_scrim</item>
        
        <!-- Inverse Colors -->
        <item name="colorInversePrimary">@color/dark_inverse_primary</item>
        <item name="colorInverseSurface">@color/dark_inverse_surface</item>
        
        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/dark_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Navigation Bar -->
        <item name="android:navigationBarColor">@color/dark_surface</item>
        <item name="android:windowLightNavigationBar">false</item>
        
        <!-- Window -->
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>
    
    <!-- ==================================================================== -->
    <!-- Dynamic Theme (Cline AI Green Palette) -->
    <!-- ==================================================================== -->
    
    <style name="Theme.Cline.Dynamic" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Inherit from Material 3 dynamic colors -->
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryContainer">@color/primary_container</item>
        <item name="android:colorOnPrimary">@color/on_primary</item>
        
        <!-- Status Bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Navigation Bar -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">false</item>
        
        <!-- Window -->
        <item name="android:windowBackground">@color/background</item>
    </style>
    
    <!-- ==================================================================== -->
    <!-- No Action Bar Theme -->
    <!-- ==================================================================== -->
    
    <style name="Theme.Cline.NoActionBar" parent="Theme.Cline.Dark">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    
    <!-- ==================================================================== -->
    <!-- Transparent Theme -->
    <!-- ==================================================================== -->
    
    <style name="Theme.Cline.Transparent" parent="Theme.Cline.Dark">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>
    
    <!-- ==================================================================== -->
    <!-- Dialog Theme -->
    <!-- ==================================================================== -->
    
    <style name="Theme.Cline.Dialog" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSurface">@color/surface_container</item>
        <item name="colorOnSurface">@color/on_surface</item>
    </style>
    
    <!-- ==================================================================== -->
    <!-- Bottom Sheet Theme -->
    <!-- ==================================================================== -->
    
    <style name="Theme.Cline.BottomSheet" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSurface">@color/surface_container</item>
        <item name="colorOnSurface">@color/on_surface</item>
    </style>
</resources>
