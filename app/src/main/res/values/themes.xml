<?xml version="1.0" encoding="utf-8"?>
<!-- themes.xml - Material Design 3 Expressive Theme Definitions -->
<resources>
    <!-- ==================================================================== -->
    <!-- Light Theme -->
    <!-- ==================================================================== -->
    
    <style name="Theme.Cline.Light" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        
        <!-- Secondary Colors -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>
        
        <!-- Tertiary Colors -->
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorTertiaryContainer">@color/tertiary_container</item>
        <item name="colorOnTertiary">@color/on_tertiary</item>
        <item name="colorOnTertiaryContainer">@color/on_tertiary_container</item>
        
        <!-- Surface Colors -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerLow">@color/surface_container_low</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_high</item>
        <item name="colorSurfaceDim">@color/surface_dim</item>
        <item name="colorSurfaceBright">@color/surface_bright</item>
        <item name="colorSurfaceTint">@color/surface_tint</item>
        
        <!-- On Surface Colors -->
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOnSurfaceInverse">@color/on_surface_inverse</item>
        
        <!-- Background Colors -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/on_background</item>
        
        <!-- Error Colors -->
        <item name="colorError">@color/error</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorOnErrorContainer">@color/on_error_container</item>
        
        <!-- Outline Colors -->
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>
        
        <!-- Scrim -->
        <item name="colorScrim">@color/scrim</item>
        
        <!-- Inverse Colors -->
        <item name="colorInversePrimary">@color/inverse_primary</item>
        <item name="colorInverseSurface">@color/inverse_surface</item>
        
        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        
        <!-- Navigation Bar -->
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightNavigationBar">true</item>
        
        <!-- Window -->
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>
    
    <!-- ==================================================================== -->
    <!-- Dark Theme -->
    <!-- ==================================================================== -->
    
    <style name="Theme.Cline.Dark" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary Colors -->
        <item name="colorPrimary">@color/dark_primary</item>
        <item name="colorPrimaryContainer">@color/dark_primary_container</item>
        <item name="colorOnPrimary">@color/dark_on_primary</item>
        <item name="colorOnPrimaryContainer">@color/dark_on_primary_container</item>
        
        <!-- Secondary Colors -->
        <item name="colorSecondary">@color/dark_secondary</item>
        <item name="colorSecondaryContainer">@color/dark_secondary_container</item>
        <item name="colorOnSecondary">@color/dark_on_secondary</item>
        <item name="colorOnSecondaryContainer">@color/dark_on_secondary_container</item>
        
        <!-- Tertiary Colors -->
        <item name="colorTertiary">@color/dark_tertiary</item>
        <item name="colorTertiaryContainer">@color/dark_tertiary_container</item>
        <item name="colorOnTertiary">@color/dark_on_tertiary</item>
        <item name="colorOnTertiaryContainer">@color/dark_on_tertiary_container</item>
        
        <!-- Surface Colors -->
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorSurfaceVariant">@color/dark_surface_variant</item>
        <item name="colorSurfaceContainer">@color/dark_surface_container</item>
        <item name="colorSurfaceContainerLow">@color/dark_surface_container_low</item>
        <item name="colorSurfaceContainerHigh">@color/dark_surface_container_high</item>
        <item name="colorSurfaceDim">@color/dark_surface_dim</item>
        <item name="colorSurfaceBright">@color/dark_surface_bright</item>
        <item name="colorSurfaceTint">@color/dark_surface_tint</item>
        
        <!-- On Surface Colors -->
        <item name="colorOnSurface">@color/dark_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/dark_on_surface_variant</item>
        <item name="colorOnSurfaceInverse">@color/dark_on_surface_inverse</item>
        
        <!-- Background Colors -->
        <item name="android:colorBackground">@color/dark_background</item>
        <item name="colorOnBackground">@color/dark_on_background</item>
        
        <!-- Error Colors -->
        <item name="colorError">@color/dark_error</item>
        <item name="colorErrorContainer">@color/dark_error_container</item>
        <item name="colorOnError">@color/dark_on_error</item>
        <item name="colorOnErrorContainer">@color/dark_on_error_container</item>
        
        <!-- Outline Colors -->
        <item name="colorOutline">@color/dark_outline</item>
        <item name="colorOutlineVariant">@color/dark_outline_variant</item>
        
        <!-- Scrim -->
        <item name="colorScrim">@color/dark_scrim</item>
        
        <!-- Inverse Colors -->
        <item name="colorInversePrimary">@color/dark_inverse_primary</item>
        <item name="colorInverseSurface">@color/dark_inverse_surface</item>
        
        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/dark_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Navigation Bar -->
        <item name="android:navigationBarColor">@color/dark_surface</item>
        <item name="android:windowLightNavigationBar">false</item>
        
        <!-- Window -->
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>
    
    <!-- ==================================================================== -->
    <!-- Dynamic Color Theme (Android 12+) -->
    <!-- ==================================================================== -->
    
    <style name="Theme.Cline.Dynamic" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Use dynamic colors -->
        <item name="colorPrimary">?attr/colorPrimary</item>
        <item name="colorPrimaryContainer">?attr/colorPrimaryContainer</item>
        <item name="colorOnPrimary">?attr/colorOnPrimary</item>
        <item name="colorOnPrimaryContainer">?attr/colorOnPrimaryContainer</item>
        
        <item name="colorSecondary">?attr/colorSecondary</item>
        <item name="colorSecondaryContainer">?attr/colorSecondaryContainer</item>
        <item name="colorOnSecondary">?attr/colorOnSecondary</item>
        <item name="colorOnSecondaryContainer">?attr/colorOnSecondaryContainer</item>
        
        <item name="colorTertiary">?attr/colorTertiary</item>
        <item name="colorTertiaryContainer">?attr/colorTertiaryContainer</item>
        <item name="colorOnTertiary">?attr/colorOnTertiary</item>
        <item name="colorOnTertiaryContainer">?attr/colorOnTertiaryContainer</item>
        
        <item name="colorSurface">?attr/colorSurface</item>
        <item name="colorSurfaceVariant">?attr/colorSurfaceVariant</item>
        <item name="colorSurfaceContainer">?attr/colorSurfaceContainer</item>
        <item name="colorSurfaceContainerLow">?attr/colorSurfaceContainerLow</item>
        <item name="colorSurfaceContainerHigh">?attr/colorSurfaceContainerHigh</item>
        <item name="colorSurfaceDim">?attr/colorSurfaceDim</item>
        <item name="colorSurfaceBright">?attr/colorSurfaceBright</item>
        <item name="colorSurfaceTint">?attr/colorSurfaceTint</item>
        
        <item name="colorOnSurface">?attr/colorOnSurface</item>
        <item name="colorOnSurfaceVariant">?attr/colorOnSurfaceVariant</item>
        <item name="colorOnSurfaceInverse">?attr/colorOnSurfaceInverse</item>
        
        <item name="android:colorBackground">?attr/colorBackground</item>
        <item name="colorOnBackground">?attr/colorOnBackground</item>
        
        <item name="colorError">?attr/colorError</item>
        <item name="colorErrorContainer">?attr/colorErrorContainer</item>
        <item name="colorOnError">?attr/colorOnError</item>
        <item name="colorOnErrorContainer">?attr/colorOnErrorContainer</item>
        
        <item name="colorOutline">?attr/colorOutline</item>
        <item name="colorOutlineVariant">?attr/colorOutlineVariant</item>
        
        <item name="colorScrim">?attr/colorScrim</item>
        
        <item name="colorInversePrimary">?attr/colorInversePrimary</item>
        <item name="colorInverseSurface">?attr/colorInverseSurface</item>
        
        <!-- Status Bar -->
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Navigation Bar -->
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightNavigationBar">false</item>
        
        <!-- Window -->
        <item name="android:windowBackground">?attr/colorBackground</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>
    
    <!-- ==================================================================== -->
    <!-- Main Theme (Used by default) -->
    <!-- ==================================================================== -->
    
    <style name="Theme.Cline" parent="Theme.Cline.Dynamic">
        <!-- Custom attributes -->
        <item name="clineColorPrimary">@color/primary</item>
        <item name="clineColorSecondary">@color/secondary</item>
        <item name="clineColorTertiary">@color/tertiary</item>
        <item name="clineColorSurface">@color/surface</item>
        <item name="clineColorBackground">@color/background</item>
        
        <!-- Typography -->
        <item name="android:fontFamily">sans-serif</item>
        
        <!-- Custom styles -->
        <item name="buttonStyle">@style/Widget.Cline.Button</item>
        <item name="textViewStyle">@style/Widget.Cline.TextView</item>
        <item name="editTextStyle">@style/Widget.Cline.EditText</item>
    </style>
    
    <!-- ==================================================================== -->
    <!-- No Action Bar Theme -->
    <!-- ==================================================================== -->
    
    <style name="Theme.Cline.NoActionBar" parent="Theme.Cline">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    
    <!-- ==================================================================== -->
    <!-- Transparent Theme -->
    <!-- ==================================================================== -->
    
    <style name="Theme.Cline.Transparent" parent="Theme.Cline">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    
    <!-- ==================================================================== -->
    <!-- Dialog Theme -->
    <!-- ==================================================================== -->
    
    <style name="Theme.Cline.Dialog" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSurface">@color/surface_container</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/error</item>
        <item name="android:windowBackground">@color/surface_container</item>
    </style>
    
    <!-- ==================================================================== -->
    <!-- Bottom Sheet Theme -->
    <!-- ==================================================================== -->
    
    <style name="Theme.Cline.BottomSheet" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSurface">@color/surface_container</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="android:windowBackground">@color/surface_container</item>
    </style>
</resources>
